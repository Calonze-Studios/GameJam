function scr_shop_item_get_info(_id){
	name = "";
	description = "";
	cost = -1;
	image = spr_placeholder_phone;
	
	switch _id {
		case 0:
			name = "Wide-screen monitor"
			description = "Brand new, used, clean, kinda dirty, ultra-special wide-screen monitor!"
			cost = 250;
			count = 1;
			image = spr_placeholder_phone;
		break;
		
	}
}